data = [eval(x.split("=")[1].strip()) for x in raw.strip().split("\n") if "mirror" in x]
n = len(data)
ms = [x[0] for x in data]
M = prod(ms)
s0 = crt([x[1][0] for x in data], ms)

W = 2**1024 
mat = Matrix(ZZ, n + 2, n + 2)

for i in range(n):
    mat[i, i] = W
    m, (s1, s2) = data[i]
    diff = (s2 - s1) % m
    Mi = M // m
    mat[i, n] = (diff * Mi * inverse_mod(Mi, m)) % M

mat[n, n] = M
mat[n+1, n+1] = W
mat[n+1, n] = s0

mat = mat.LLL()

for r in mat:
    if abs(r[n+1]) == W:
        ans = r[n] % M if r[n+1] == W else -r[n] % M
        if 0 < ans < 2**1025:
            print("s =", ans)
            break