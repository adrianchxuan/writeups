<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101522">
  <title>Comments | Ado fans</title>
  <link href="https://fonts.googleapis.com/css?family=DM+Sans:400,500,600,700&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
      --page: #101522;
      --panel: #171e2d;
      --panel-raised: #1c2638;
      --accent: #a7f36b;
      --text: #f4f7fb;
      --muted: #a5afbf;
      --border: rgba(255, 255, 255, 0.1);
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 28px;
      background:
        radial-gradient(ellipse at 80% 0%, rgba(95, 126, 72, 0.2), transparent 38%),
        var(--page);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .shell {
      width: min(900px, 100%);
      margin: 0 auto;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0 30px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: -0.04em;
    }

    .brand-mark {
      display: grid;
      width: 34px;
      height: 34px;
      place-items: center;
      border-radius: 11px;
      background: var(--accent);
      color: var(--page);
    }

    .back-link {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .back-link:hover {
      color: var(--accent);
    }

    .heading {
      margin-bottom: 22px;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.2rem, 7vw, 3.6rem);
      letter-spacing: -0.07em;
    }

    .subtitle {
      margin: 9px 0 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .composer,
    .comment-card {
      border: 1px solid var(--border);
      border-radius: 18px;
      background: rgba(23, 30, 45, 0.92);
    }

    .composer {
      margin-bottom: 24px;
      padding: 22px;
    }

    .composer label {
      display: block;
      margin-bottom: 10px;
      font-size: 0.95rem;
      font-weight: 700;
    }

    textarea {
      display: block;
      width: 100%;
      min-height: 120px;
      resize: vertical;
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      outline: none;
      background: var(--page);
      color: var(--text);
      font: inherit;
      line-height: 1.6;
    }

    textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(167, 243, 107, 0.13);
    }

    .composer-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-top: 14px;
    }

    .hint,
    .feedback {
      color: var(--muted);
      font-size: 0.85rem;
    }

    .feedback {
      min-height: 1.4em;
      margin: 12px 0 0;
    }

    .feedback[data-state="error"] {
      color: #ff9c9c;
    }

    button {
      padding: 12px 17px;
      border: 0;
      border-radius: 10px;
      background: var(--accent);
      color: var(--page);
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      transition: transform 160ms ease, opacity 160ms ease;
    }

    button:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    button:disabled {
      cursor: wait;
      opacity: 0.65;
    }

    .list-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin: 0 0 12px;
    }

    .list-heading h2 {
      margin: 0;
      font-size: 1.2rem;
      letter-spacing: -0.03em;
    }

    .comment-list {
      display: grid;
      gap: 12px;
    }

    .comment-card {
      padding: 18px 20px;
      background: linear-gradient(145deg, rgba(28, 38, 56, 0.95), rgba(23, 30, 45, 0.95));
    }

    .comment-header {
      display: flex;
      align-items: center;
      gap: 11px;
      margin-bottom: 12px;
    }

    .avatar {
      display: grid;
      width: 38px;
      height: 38px;
      flex: 0 0 auto;
      place-items: center;
      border: 1px solid rgba(167, 243, 107, 0.24);
      border-radius: 13px;
      background: rgba(167, 243, 107, 0.1);
      color: var(--accent);
      font-weight: 700;
    }

    .username {
      font-weight: 700;
    }

    .comment-label {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 0.78rem;
    }

    .comment-body {
      margin: 0;
      color: #dce2ec;
      line-height: 1.7;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }

    .empty-state {
      padding: 26px;
      border: 1px dashed var(--border);
      border-radius: 16px;
      color: var(--muted);
      text-align: center;
    }

    @media (max-width: 600px) {
      body {
        padding: 18px;
      }

      .composer {
        padding: 18px;
      }

      .composer-actions {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/ado-theme.css">
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Ado home">
        <img class="brand-mark" src="/assets/Ado.jpg" alt="Ado">
        <span>ado</span>
      </a>
      <a class="back-link" href="/">Back to Ado <span aria-hidden="true">↗</span></a>
    </header>

    <main>
      <div class="heading">
        <p class="eyebrow">Ado fan community</p>
        <h1>Fan comments</h1>
        <p class="subtitle">Share a thought about the music with the community.</p>
      </div>

      <form class="composer" id="comment-form">
        <label for="comment-body">Leave a comment</label>
        <textarea id="comment-body" name="body" maxlength="2000" placeholder="What are you listening to lately?" required></textarea>
        <input id="post-id" type="hidden" value="{{ postId }}">
        <div class="composer-actions">
          <span class="hint">Keep it kind and enjoy the music.</span>
          <button type="submit">Post comment <span aria-hidden="true">→</span></button>
        </div>
        <p class="feedback" id="comment-feedback" role="status" aria-live="polite"></p>
      </form>

      <section aria-labelledby="comments-heading">
        <div class="list-heading">
          <h2 id="comments-heading">Community conversation</h2>
        </div>
        <div class="comment-list">
          @each(comment in comments)
            <article class="comment-card">
              <header class="comment-header">
                <span class="avatar" aria-hidden="true">{{ comment.username[0] }}</span>
                <div>
                  <span class="username">{{ comment.username }}</span>
                  <span class="comment-label">Ado fan</span>
                </div>
              </header>
              <p class="comment-body">{{ comment.body }}</p>
            </article>
          @else
            <p class="empty-state">No comments yet. Start the conversation!</p>
          @end
        </div>
      </section>
    </main>
  </div>
  <script>
    const commentForm = document.getElementById('comment-form')
    const commentFeedback = document.getElementById('comment-feedback')

    commentForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      const submitButton = commentForm.querySelector('button')
      submitButton.disabled = true
      commentFeedback.dataset.state = ''
      commentFeedback.textContent = 'Posting your comment…'

      try {
        const response = await fetch('/api/v1/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            postId: Number(document.getElementById('post-id').value),
            body: document.getElementById('comment-body').value,
          }),
        })
        const result = await response.json()
        if (!response.ok) throw new Error(result.error || 'Unable to post comment.')
        window.location.reload()
      } catch (error) {
        commentFeedback.dataset.state = 'error'
        commentFeedback.textContent = error.message || 'Unable to connect. Please try again.'
        submitButton.disabled = false
      }
    })
  </script>
</body>
</html>
