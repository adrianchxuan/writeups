<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101522">
  <title>Moderation | Ado fans</title>
  <link href="https://fonts.googleapis.com/css?family=DM+Sans:400,500,600,700&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
      --page: #101522;
      --panel: #171e2d;
      --accent: #a7f36b;
      --text: #f4f7fb;
      --muted: #a5afbf;
      --border: rgba(255, 255, 255, 0.1);
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 28px;
      background:
        radial-gradient(ellipse at 80% 0%, rgba(95, 126, 72, 0.2), transparent 38%),
        var(--page);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
    }

    .shell {
      width: min(900px, 100%);
      margin: 0 auto;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0 30px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--text);
      font-size: 1.1rem;
      font-weight: 700;
      text-decoration: none;
    }

    .brand-mark {
      display: grid;
      width: 34px;
      height: 34px;
      place-items: center;
      border-radius: 11px;
      background: var(--accent);
      color: var(--page);
    }

    .admin-label {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .heading {
      margin-bottom: 22px;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.2rem, 7vw, 3.6rem);
      letter-spacing: -0.07em;
    }

    .subtitle {
      margin: 9px 0 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .comment-list {
      display: grid;
      gap: 12px;
    }

    .comment-card {
      padding: 18px 20px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: linear-gradient(145deg, rgba(28, 38, 56, 0.95), rgba(23, 30, 45, 0.95));
    }

    .comment-header {
      display: flex;
      align-items: center;
      gap: 11px;
      margin-bottom: 12px;
    }

    .avatar {
      display: grid;
      width: 38px;
      height: 38px;
      flex: 0 0 auto;
      place-items: center;
      border: 1px solid rgba(167, 243, 107, 0.24);
      border-radius: 13px;
      background: rgba(167, 243, 107, 0.1);
      color: var(--accent);
      font-weight: 700;
    }

    .username {
      font-weight: 700;
    }

    .comment-label {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 0.78rem;
    }

    .comment-body {
      margin: 0;
      color: #dce2ec;
      line-height: 1.7;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }

    .empty-state {
      padding: 26px;
      border: 1px dashed var(--border);
      border-radius: 16px;
      color: var(--muted);
      text-align: center;
    }

    @media (max-width: 600px) {
      body {
        padding: 18px;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/ado-theme.css">
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Ado home">
        <img class="brand-mark" src="/assets/Ado.jpg" alt="Ado">
        <span>ado</span>
      </a>
      <a class="admin-label" href="/admin">← Admin menu</a>
    </header>

    <main>
      <div class="heading">
        <p class="eyebrow">Ado fan community</p>
        <h1>Comment moderation</h1>
        <p class="subtitle">Review the latest notes from the community.</p>
      </div>

      <section class="comment-list" aria-label="Submitted comments">
        @each(comment in comments)
          <article class="comment-card">
            <header class="comment-header">
              <span class="avatar" aria-hidden="true">{{ comment.username[0] }}</span>
              <div>
                <span class="username">{{ comment.username }}</span>
                <span class="comment-label">Community comment</span>
              </div>
            </header>
            <p class="comment-body">{{{ comment.body }}}</p>
          </article>
        @else
          <p class="empty-state">No comments to review yet.</p>
        @end
      </section>
    </main>
  </div>
</body>
</html>
